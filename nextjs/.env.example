# ── Pusher (realtime) ──────────────────────────────────────────────
# Заполни значениями из своего приложения на pusher.com → Channels → App Keys.
# Без этих ключей приложение работает на поллинге (обновление раз в ~12с).

# Серверные (секрет, НЕ public):
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Клиентские (public — прокидываются в браузер):
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Примечание: NEXT_PUBLIC_PUSHER_KEY = PUSHER_KEY (это один и тот же «key»),
# просто public-копия для клиента. CLUSTER должен совпадать во всех четырёх.
